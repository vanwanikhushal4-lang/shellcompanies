{
  "version": "1.0.0",
  "principles": {
    "free_public_sources_only": true,
    "missing_values": "null",
    "field_level_provenance": true,
    "time_aware": true,
    "features_separate_from_labels": true
  },
  "tables": {
    "company_facts": [
      "fact_id", "company_id", "cin", "field_name", "value", "value_type",
