    "documents": [
      "document_id", "company_id", "cin", "document_type", "title", "publisher",
      "document_date", "source_url", "local_path", "sha256", "file_size_bytes",
      "retrieved_at", "access_class", "notes"
    ],
    "conflicts": [
      "conflict_id", "company_id", "cin", "field_name", "value_a", "source_a",
      "value_b", "source_b", "conflict_status", "resolution", "reviewer", "reviewed_at"
    ]
  }
}
